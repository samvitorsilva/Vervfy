# Placeholder-only environment for the guarded production migration/ACL tools.
# Copy this file outside the repository and replace placeholders using a
# trusted secret manager. Never commit a populated copy or paste credentials.

export VERVFY_ENVIRONMENT='production'
export VERVFY_PRODUCTION_PROJECT_REF='__APPROVED_PRODUCTION_PROJECT_REF__'
export VERVFY_PRODUCTION_EXPECTED_DATABASE='postgres'
export VERVFY_PRODUCTION_EXPECTED_USER='vervfy_prod_migrator'

# The ACL plan supports 0032 or 0033; set this to a fresh read-only revision check.
export VERVFY_PRODUCTION_START_REVISION='0032_auth_sessions'

# direct: db.<project-ref>.supabase.co:5432
# session: aws-0-us-east-2.pooler.supabase.com:5432
export VERVFY_PRODUCTION_CONNECTION_MODE='direct'

# Use the trusted, pinned production CA bundle. The URL's sslrootcert must
# resolve to this exact same file. The runner requires sslmode=verify-full.
export VERVFY_PRODUCTION_CA_FILE='/absolute/path/to/pinned-production-ca.pem'
export VERVFY_PRODUCTION_DATABASE_URL='postgresql+psycopg://vervfy_prod_migrator:__URL_ENCODED_PASSWORD__@db.__APPROVED_PRODUCTION_PROJECT_REF__.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/pinned-production-ca.pem'

# Session Pooler alternative (set mode to session and use its project-qualified
# login; do not set both URLs):
# export VERVFY_PRODUCTION_CONNECTION_MODE='session'
# export VERVFY_PRODUCTION_DATABASE_URL='postgresql+psycopg://vervfy_prod_migrator.__APPROVED_PRODUCTION_PROJECT_REF__:__URL_ENCODED_PASSWORD__@aws-0-us-east-2.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/pinned-production-ca.pem'

# These must be unset in the dedicated runner shell:
# DATABASE_URL MIGRATION_DATABASE_URL
# PGHOST PGPORT PGDATABASE PGUSER PGPASSWORD PGOPTIONS PGSERVICE
# PGSERVICEFILE PGSSLMODE PGSSLROOTCERT
