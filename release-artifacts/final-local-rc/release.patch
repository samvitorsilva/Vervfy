+                if count > max_bytes:
+                    raise LocalStorageError("Local object exceeds download size limit")
+                view = memoryview(chunk)
+                while view:
+                    written = os.write(target_fd, view)
+                    if written <= 0:
+                        raise LocalStorageError("Local download write made no progress")
+                    view = view[written:]
