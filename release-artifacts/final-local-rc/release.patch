+                "Local download destination must be a separate /tmp file"
+            )
+        source_fd = self._open_file(path)
+        target_fd = None
+        count = 0
+        try:
+            target_fd = os.open(
+                destination,
+                os.O_WRONLY
+                | os.O_CREAT
+                | os.O_TRUNC
+                | getattr(os, "O_CLOEXEC", 0)
+                | getattr(os, "O_NOFOLLOW", 0),
+                0o600,
