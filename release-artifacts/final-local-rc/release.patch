+        return _google_oauth_failed(config, purpose)
+    except ValueError:
+        return _google_oauth_failed(config, purpose)
+    except (SQLAlchemyError, RuntimeError, google_oauth.OAuthBackendUnavailable):
+        return _google_oauth_unavailable()
+    return _google_oauth_failed(config, purpose)
 
 
