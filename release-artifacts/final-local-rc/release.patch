+            auth, "verify_password", side_effect=verify
+        ) as password_check:
+            with ThreadPoolExecutor(max_workers=16) as pool:
+                statuses = list(pool.map(attempt, range(16)))
+            self.assertEqual(statuses.count(400), 10)
+            self.assertEqual(statuses.count(429), 6)
