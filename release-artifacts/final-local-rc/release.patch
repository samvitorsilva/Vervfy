+        waiting = threading.Event()
+        release = threading.Event()
+        first = []
+        upload = lifecycle.upload_bytes
+
+        def paused(*args, **kwargs):
+            path = upload(*args, **kwargs)
+            if threading.get_ident() == first[0]:
+                waiting.set()
+                self.assertTrue(release.wait(10))
+            return path
