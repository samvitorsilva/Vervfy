+            try:
+                deadline = time.monotonic() + 5
+                while True:
+                    try:
+                        client.ping()
+                        break
+                    except redis.RedisError:
+                        if process.poll() is not None or time.monotonic() >= deadline:
+                            self.fail("Disposable Redis did not start")
