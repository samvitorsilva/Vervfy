+        log.warning("artist photo lookup failed for %r: %s", name, exc)
+        return None
+    if found:
+        _ARTIST_PHOTO_CACHE[key] = (now + _PHOTO_HIT_TTL, found[0], frozenset(found[1]))
+        return found[0]
+    _ARTIST_PHOTO_CACHE[miss_key] = (now + _PHOTO_MISS_TTL, None, frozenset())
+    return None
 
 
