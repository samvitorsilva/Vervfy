# Supabase Dashboard -> Connect -> SQLAlchemy/Python connection string.
# Use a dedicated app_runtime role rather than the Supabase postgres owner.
# Use the pooler URL for Render if direct database connections are unavailable.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require

# Required in production: a stable random value, e.g. `openssl rand -hex 32`.
VERVFY_SECRET_KEY=replace-with-a-long-random-secret
VERVFY_HTTPS_ONLY=1
VERVFY_ENVIRONMENT=production
VERVFY_COOKIE_SAME_SITE=lax
# CORS allowlist for the Next.js origin when browsers call the API directly.
# Same-origin traffic through the Next rewrite proxy does not need this.
# Set this to the deployed frontend origin in the Render dashboard (not the API).
# FRONTEND_URL=https://YOUR-FRONTEND-HOST
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_KEY=YOUR_SERVER_SIDE_SERVICE_KEY
SUPABASE_BUCKET=songs
# Password recovery and email verification are not implemented; SMTP settings are unused.
VERVFY_SMTP_HOST=smtp.example.com
VERVFY_SMTP_PORT=587
VERVFY_SMTP_USERNAME=your-smtp-username
VERVFY_SMTP_PASSWORD=your-smtp-password
VERVFY_EMAIL_FROM="Vervfy <no-reply@example.com>"
# Number of trusted reverse-proxy hops before the client IP (Render: 1).
VERVFY_TRUSTED_PROXY_HOPS=1
# Per-user upload cap in each 10-minute window.
VERVFY_UPLOADS_PER_10MIN=60
# Set to 0 to disable external LRCLIB lookups; default is enabled.
LYRICS_PROVIDER_LRCLIB=1
# TheAudioDB public API key; set your paid key here when you upgrade.
AUDIODB_API_KEY=123
# Required for multi-worker/instance rate limiting.
REDIS_URL=redis://:password@host:6379/0
# Set to 1 only when scripts/upload_worker.py runs as a separate service.
VERVFY_ASYNC_UPLOADS=0

# Google OAuth is intentionally disabled unless explicitly enabled. The
# lookup URL must use a separate login granted only the
# vervfy_identity_lookup executor role, never app_runtime.
GOOGLE_OAUTH_ENABLED=0
# Required when enabled: exactly one Google-verified test-user email (server only).
# GOOGLE_OAUTH_TEST_USER_EMAIL=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://YOUR-FRONTEND-HOST/api/auth/google/callback
# GOOGLE_FRONTEND_ORIGIN=https://YOUR-FRONTEND-HOST
# GOOGLE_IDENTITY_LOOKUP_DATABASE_URL=postgresql+psycopg://vervfy_identity_lookup:...@HOST/DATABASE?sslmode=require

# Next.js frontend: public canonical origin for previews and sitemap.
# Render supplies RENDER_EXTERNAL_URL automatically; set SITE_URL for a custom domain.
# SITE_URL=https://YOUR-FRONTEND-HOST
